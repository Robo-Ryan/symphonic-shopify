  <section id="apply" class="closer">
    <div class="container">
      <div class="closer-grid">
        <div>
          <span class="eyebrow">Apply for Access</span>
          <h2>Ready to put it <em>on your shelf?</em></h2>
          <p class="closer-lede">Tell us about your store. We'll send back wholesale pricing, the full catalog, and portal credentials within one business day.</p>
          <div class="closer-meta">
            <strong>What you'll receive:</strong><br>
            Live wholesale pricing &amp; margin sheets · Full catalog beyond the starter assortment · MOQ &amp; replenishment terms · A dedicated partner specialist · Testers &amp; educational POS on first order.
          </div>
        </div>

        <div class="apply-card">
          <span class="eyebrow">New Partner Application</span>
          <h3>Apply for portal access.</h3>

          {% form 'contact', id: 'ContactForm', class: 'contact-form' %}
            <input type="hidden" name="contact[B2B_Application]" value="Symphonic M.D. — new B2B customer application to review" />

            {%- if form.posted_successfully? -%}
              <div class="form-success" id="form-success">
                <div class="check-mark">✓</div>
                <h4>Application <em>received.</em></h4>
                <p>Thanks. We'll be in touch within one business day with portal access, wholesale pricing, and the full catalog.</p>
              </div>
              <script>
                document.addEventListener('DOMContentLoaded', function() {
                  var el = document.getElementById('form-success');
                  if (el) el.scrollIntoView({ behavior: 'smooth', block: 'center' });
                });
              </script>
            {%- endif -%}

            {%- if form.errors -%}
              <div class="form-errors">{{ form.errors | default_errors }}</div>
            {%- endif -%}

            <div class="field-row">
              <div class="field">
                <label for="ContactForm-company">Company Name <span class="req">●</span></label>
                <input type="text" id="ContactForm-company" name="contact[company-name]" placeholder="Your store or business" required />
              </div>
              <div class="field">
                <label for="ContactForm-name">Your Name <span class="req">●</span></label>
                <input type="text" id="ContactForm-name" name="contact[your-name]" placeholder="First and last name" required />
              </div>
            </div>

            <div class="field-row">
              <div class="field">
                <label for="ContactForm-email">Email <span class="req">●</span></label>
                <input type="email" id="ContactForm-email" name="contact[email]" placeholder="you@yourstore.com" required />
              </div>
              <div class="field">
                <label for="ContactForm-url">Website / Store URL <span class="opt">Optional</span></label>
                <input type="text" id="ContactForm-url" name="contact[url]" placeholder="yourstore.com" />
              </div>
            </div>

            <div class="field">
              <label for="ContactForm-comments">Tell us about your store <span class="opt">Optional</span></label>
              <textarea id="ContactForm-comments" name="contact[comments]" placeholder="Store type, location, categories you carry, ideal launch timing. Anything that helps us prep your account."></textarea>
            </div>

            <div class="apply-foot">
              <button type="submit" class="btn btn-primary" style="width:100%;padding:16px 26px;font-size:15px;">Apply to View Wholesale Prices</button>
              <small>By applying you'll receive product news, education, and wholesale updates. Unsubscribe anytime.</small>
            </div>

            <div class="already-member">
              Already a wholesale partner? <a href="/account/login">Sign in to the portal →</a>
            </div>
          {% endform %}
        </div>
      </div>
    </div>
  </section>

