<style type="text/css">
.featured-on__content {
    border-top: 1px solid #000;
    border-bottom: 1px solid #000;
    padding: 3rem 0;
    margin-top: -2rem;
    margin-bottom: 6rem;
}
.featured-on__logo {
    text-align: center;
}
.featured-on__logo img {
    width: 100%;
    max-width: 150px;
}
.featured-on__content .s3 {
    color: rgb(var(--brand-color-green));
}
.featured-on__desc {
    padding-bottom: 2rem;
    display: flex;
}
.featured-on__desc p {
    margin: 0;
    padding: 0;
    width: 80%;
    margin-left: auto;
}
@media (min-width: 768px) {
    
    .featured-on__content {
        display: flex;
        align-items: center;    
    }
    .featured-on__logo {
        width: 35%;
        margin: 0;
    }
    .featured-on__desc {
        padding-bottom: 0;
        width: 65%;
    }
    .featured-on__desc p {
        width: 91%;
    }
}

.featured-on__content--column {
    display: flex;
    justify-content: center;
}
.featured-on__content--column .featured-on__logo {
    width: 200px;
}
.featured-on__content--column .featured-on__logo img {
    width: 100%;
    max-width: 100%;
}
</style>
<div class="featured-on container">
    <div class="featured-on__content featured-on__content--{{ section.settings.layout }}">
    {%- if section.settings.description != blank -%}
    <div class="featured-on__desc b1-lg">
        {% render 'symphonic-icon' with 'arrow-right' %}
        {{ section.settings.description }}
    </div>
    {%- endif -%}
    <div class="featured-on__logo">
        <h3 class="{% if section.settings.layout == 'row' %}s3{% else %}badge{% endif %}">{{ section.settings.heading }}</h3>
        {{- section.settings.logo | image_url: width: block.settings.logo.width | image_tag -}}

    </div>
    </div>
</div>

{% schema %}
    {
        "name": "SMD - Featured On",
        "class": "featured-on",
        "settings": [
            {
                "type": "image_picker",
                "id": "logo",
                "label": "Logo"
            },
            {
                "type": "text",
                "id": "heading",
                "label": "Heading",
                "default": "As Seen On"
            },
            {
                "type": "richtext",
                "id": "description",
                "label": "Description",
                "default": "<p></p>"
            },
            {
                "type": "select",
                "id": "layout",
                "label": "Layout",
                "options": [
                    {
                    "value": "row",
                    "label": "Row"
                    },
                    {
                        "value": "column",
                        "label": "Column"
                    }
                ],
                "default": "row"
            }
        ],
        "presets": [
            {
              "name": "SMD - Featured On",
              "settings": {}
            }
        ]
    }
{% endschema %}
