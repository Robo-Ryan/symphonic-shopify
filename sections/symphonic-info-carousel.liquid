<style type="text/css">

#shopify-section-{{ section.id }}.smd-info-carousel {
    padding: {{ section.settings.mobile_top_spacing }}px 0 {{ section.settings.mobile_bottom_spacing }}px  ;
}
.info-carousel__slide {
    padding: 20px 0;
}
@media (min-width: 741px) {
    #shopify-section-{{ section.id }}.smd-info-carousel {
        padding: {{ section.settings.desktop_top_spacing }}px 0 {{ section.settings.desktop_bottom_spacing }}px  ;
    }
    .info-carousel {
        display: flex;
    }
    .info-carousel__img {
        width: 32%;
    }
    .info-carousel__slider-container {
        width: 66%;
        margin-left: auto;
    }
    .info-carousel__slide {
        width: 50%;
        padding: 16px;
    }
    .info-carousel__slider-indicator {
        width: 55%;
        height: 1px;
        background: rgb(var(--brand-color-black));
        position: relative;
        margin: 7px 0 28px 16px;
    }
    .info-carousel__slider-indicator:before, .info-carousel__slider-indicator:after {
        display: block;
        width: 15px;
        height: 15px;
        border-radius: 15px;
        background: rgb(var(--brand-color-black));
        content: "";
        position: absolute;
        top: -7px;
    }
    .info-carousel__slider-indicator:after {
        right: 0;
    }
    
}
.info-carousel__slider-nav {
    width: 100%;
    display: flex;
    justify-content: flex-end;
}
.info-carousel__pagination-btn--next {
    margin-left: 30px;
}
.info-carousel__header {
    padding: 0 0 3.5rem;
}
@media (min-width: 741px) {
    .info-carousel__slider-nav {
        display: none;
    }
}
</style>
<div class="container">
    <div class="info-carousel__header hidden-tablet-and-up">
        <h2 class="h1 m-h5">OUR CLINICAL TESTING STANDARDS</h2>
    </div>
    <div class="info-carousel">
        <div class="info-carousel__img">
            {%- if section.settings.image != blank -%}
                {{- section.settings.image | image_url: width: section.settings.image.width | image_tag: loading: 'lazy', widths: '600,700,800,1000,1200,1400,1600,1800,2000,2200,2400,2600,2800,3000' -}}
            {%- else -%}
                {{- 'image' | placeholder_svg_tag: "bordered" -}}
            {%- endif -%}
        </div>
        <div class="info-carousel__slider-container">
            <div class="info-carousel__slider-indicator"></div>
            <div class="info-carousel__slider">
            {%- for block in section.blocks -%}
                <div class="info-carousel__slide">
                    {{ block.settings.info }}
                </div>
            {%- endfor -%}
            </div>
        </div>
        <div class="info-carousel__slider-nav">
            <button class="info-carousel__pagination-btn info-carousel__pagination-btn--prev">{%- render 'symphonic-icon' with 'arrow-left', width: 21, height: 22 -%}</button>
            <button class="info-carousel__pagination-btn info-carousel__pagination-btn--next">{%- render 'symphonic-icon' with 'arrow-right', width: 21, height: 22 -%}</button>
        </div>
    </div>
</div>

{% schema %}
    {
        "name": "SMD - Info carousel",
        "class": "smd-info-carousel",
        "settings": [
            {
                "type": "image_picker",
                "id": "image",
                "label": "Image"
            },
            {
                "type": "header",
                "content": "Desktop Spacing"
            },
            {
                "type": "range",
                "id": "desktop_top_spacing",
                "min": 0,
                "max": 100,
                "step": 1,
                "unit": "px",
                "label": "Top",
                "default": 60
            },
            {
                "type": "range",
                "id": "desktop_bottom_spacing",
                "min": 0,
                "max": 100,
                "step": 1,
                "unit": "px",
                "label": "Bottom",
                "default": 60
            },
            {
                "type": "header",
                "content": "Mobile Spacing"
            },
            {
                "type": "range",
                "id": "mobile_top_spacing",
                "min": 0,
                "max": 100,
                "step": 1,
                "unit": "px",
                "label": "Top",
                "default": 60
            },
            {
                "type": "range",
                "id": "mobile_bottom_spacing",
                "min": 0,
                "max": 100,
                "step": 1,
                "unit": "px",
                "label": "Bottom",
                "default": 60
            }
        ],
        "blocks": [
            {
                "type": "info",
                "name": "info",
                "settings": [
                    {
                        "type": "richtext",
                        "id": "info",
                        "label": "Info",
                        "default": "<p></p>"
                    }
                ]
            }
        ],
        "presets": [
            {
              "name": "SMD - Info carousel",
              "settings": {}
            }
        ]
    }
{% endschema %}