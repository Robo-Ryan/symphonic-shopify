<style type="text/css">
#shopify-section-{{ section.id }}.featured-editorial {
    padding: {{ section.settings.mobile_top_spacing }}px 0 {{ section.settings.mobile_bottom_spacing }}px  ;
  }
  @media (min-width: 741px) {
    #shopify-section-{{ section.id }}.featured-editorial {
      padding: {{ section.settings.desktop_top_spacing }}px 0 {{ section.settings.desktop_bottom_spacing }}px  ;
    }
  }
</style>
<div class="container">

    {%- if section.settings.show_image -%}
    <div class="featured-editorial__image{% if section.settings.original_mobile_aspect_ratio %} featured-editorial__image--original-m-ratio{% endif %}{% if section.settings.enable_zoom_animation %} gsap-banner-scale{% endif %}">
        <div class="featured-editorial__image-img">
        {%- if section.settings.image != blank -%}
            {{- section.settings.image | image_url: width: section.settings.image.width | image_tag: loading: 'lazy', widths: '600,700,800,1000,1200,1320,1400,1600,1800,2000,2200,2400,2600,2800,3000', class: 'rellax',  data-rellax-percentage: "0.5" -}}
        {%- else -%}
            {{- 'lifestyle-1' | placeholder_svg_tag: "bordered" -}}
        {%- endif -%}
        </div>
    </div>
    {%- endif -%}

    <div class="featured-editorial__text featured-editorial__text--{{ section.settings.content_style }} featured-editorial__text--{{ section.settings.text_alignment }}">
        <{{ section.settings.heading_tag }} class="featured-editorial__title {% if section.settings.content_style == 'large-title' %}h1 m-h5{% else %}s2 m-s3{% endif %}">
            {{ section.settings.title }}
        </{{ section.settings.heading_tag }}>
        <div class="featured-editorial__desc {% if section.settings.content_style == 'large-title' %}h4 m-b1-lg{% else %}h2 m-h4{% endif %}">
            {{ section.settings.description | newline_to_br }}
        </div>
    </div>

</div>

{% schema %}
    {
        "name": "SMD - Featured Editorial",
        "class": "featured-editorial",
        "settings": [
            {
                "type": "image_picker",
                "id": "image",
                "label": "Image"
            },
            {
                "type": "checkbox",
                "id": "show_image",
                "label": "Show image",
                "default": true
            },
            {
                "type": "checkbox",
                "id": "original_mobile_aspect_ratio",
                "label": "Use original aspect ratio on mobile",
                "default": false
            },
            {
                "type": "checkbox",
                "id": "enable_zoom_animation",
                "label": "Enable zoom animation",
                "default": false
            },
            {
                "type": "text",
                "id": "title",
                "label": "Heading"
            },
            {
                "type": "select",
                "id": "heading_tag",
                "label": "Heading Tag",
                "options": [
                    {
                    "value": "h1",
                    "label": "H1"
                    },
                    {
                    "value": "h2",
                    "label": "H2"
                    },
                    {
                    "value": "h3",
                    "label": "H3"
                    },
                    {
                    "value": "h4",
                    "label": "H4"
                    },
                    {
                    "value": "h5",
                    "label": "H5"
                    },
                    {
                    "value": "p",
                    "label": "P"
                    },
                    {
                    "value": "div",
                    "label": "DIV"
                    }
                ],
                "default": "h2"
            },
            {
                "type": "textarea",
                "id": "description",
                "label": "Description"
            },
            {
                "type": "select",
                "id": "text_alignment",
                "label": "Text alignment",
                "options": [
                    {
                    "value": "left",
                    "label": "Left"
                    },
                    {
                        "value": "center",
                        "label": "Center"
                    },
                    {
                        "value": "right",
                        "label": "Right"
                    }
                ],
                "default": "center"
            },
            {
                "type": "select",
                "id": "content_style",
                "label": "Content style",
                "options": [
                    {
                    "value": "small-title",
                    "label": "Small title with larger description"
                    },
                    {
                        "value": "large-title",
                        "label": "Large title with smaller description"
                    }
                ],
                "default": "small-title"
            },
            {
                "type": "header",
                "content": "Desktop Spacing"
            },
            {
                "type": "range",
                "id": "desktop_top_spacing",
                "min": 0,
                "max": 100,
                "step": 1,
                "unit": "px",
                "label": "Top",
                "default": 100
            },
            {
                "type": "range",
                "id": "desktop_bottom_spacing",
                "min": 0,
                "max": 100,
                "step": 1,
                "unit": "px",
                "label": "Bottom",
                "default": 0
            },
            {
                "type": "header",
                "content": "Mobile Spacing"
            },
            {
                "type": "range",
                "id": "mobile_top_spacing",
                "min": 0,
                "max": 100,
                "step": 1,
                "unit": "px",
                "label": "Top",
                "default": 60
            },
            {
                "type": "range",
                "id": "mobile_bottom_spacing",
                "min": 0,
                "max": 100,
                "step": 1,
                "unit": "px",
                "label": "Bottom",
                "default": 0
            }
        ],
        "presets": [
            {
              "name": "SMD - Featured Editorial",
              "settings": {}
            }
        ]
    }
{% endschema %}
